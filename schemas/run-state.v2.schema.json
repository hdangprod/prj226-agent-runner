{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RunStateV2",
  "description": "V2 lifecycle state snapshot persisting policy, outcome, and candidate identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state_version",
    "run_id",
    "state",
    "updated_at",
    "last_event",
    "stop_reason",
    "contract_id",
    "review_policy",
    "review_attempted",
    "review_status",
    "candidate_head",
    "candidate_tree",
    "candidate_ref"
  ],
  "properties": {
    "state_version": {"const": "HARN-001.RUN_STATE.v2"},
    "run_id": {"type": "string", "minLength": 1},
    "state": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "last_event": {"type": "string", "minLength": 1},
    "stop_reason": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "contract_id": {"type": "string", "minLength": 1},
    "review_policy": {"type": "object"},
    "review_attempted": {"type": "boolean"},
    "review_status": {"anyOf": [{"type": "string", "enum": ["NOT_REQUIRED", "PASS", "NEEDS_FIX", "EXECUTION_FAILURE"]}, {"type": "null"}]},
    "candidate_head": {"anyOf": [{"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}, {"type": "null"}]},
    "candidate_tree": {"anyOf": [{"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}, {"type": "null"}]},
    "candidate_ref": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
  }
}
