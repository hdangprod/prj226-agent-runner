{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Harn002ControllerResult",
  "description": "Closed exact result-ingestion record for one HARN-001 run; ACCEPTANCE_READY requires the complete evidence bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["result", "controller_phase", "run_id", "candidate_head", "candidate_tree", "deterministic_result", "reviewer_disposition", "evidence_references", "error_class"],
  "properties": {
    "result": {"type": "string", "enum": ["RESULT_INGESTED"]},
    "controller_phase": {"type": "string", "enum": ["ACCEPTANCE_READY", "STOPPED"]},
    "run_id": {"type": "string", "minLength": 1},
    "candidate_head": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$"},
    "candidate_tree": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$"},
    "candidate_ref": {"type": ["string", "null"], "minLength": 1},
    "deterministic_result": {"type": "string", "enum": ["ACCEPTANCE_READY", "STOPPED"]},
    "verification_disposition": {"type": "string", "enum": ["PASS", "NEEDS_FIX", "STOPPED"]},
    "reviewer_disposition": {"type": "object", "additionalProperties": false, "properties": {"dv_result": {"type": "string"}, "sos_result": {"type": "string"}, "review_disposition": {"type": "string", "enum": ["PASS", "NEEDS_FIX"]}}},
    "evidence_references": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "required_evidence_references": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_paths": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "candidate_worktree_fingerprint": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "review_worktree_fingerprint": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "review_artifact": {"type": ["string", "null"], "minLength": 1},
    "review_raw_artifact": {"type": ["string", "null"], "minLength": 1},
    "review_fingerprint_pre_artifact": {"type": ["string", "null"], "minLength": 1},
    "review_fingerprint_post_artifact": {"type": ["string", "null"], "minLength": 1},
    "review_artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "error_class": {"type": ["string", "null"], "enum": ["ENVIRONMENT_ERROR", "AGENT_EXECUTION_ERROR", "ARTIFACT_VALIDATION_ERROR", "IMPLEMENTATION_FAILURE", "GOVERNANCE_BLOCKER", null]}
  }
}
