{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodexIndependentReviewerResult",
  "description": "Closed HARN-002 Repair-4 result from the explicitly bound Codex independent reviewer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "disposition",
    "reviewed_head",
    "reviewed_tree",
    "security",
    "operability",
    "semantics",
    "architecture",
    "blocking_findings",
    "non_blocking_findings"
  ],
  "properties": {
    "disposition": {"type": "string", "enum": ["PASS", "NEEDS_FIX"]},
    "reviewed_head": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "reviewed_tree": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "security": {"$ref": "#/definitions/axis"},
    "operability": {"$ref": "#/definitions/axis"},
    "semantics": {"$ref": "#/definitions/axis"},
    "architecture": {"$ref": "#/definitions/axis"},
    "blocking_findings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "non_blocking_findings": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "definitions": {
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "findings"],
      "properties": {
        "status": {"type": "string", "enum": ["PASS", "NEEDS_FIX"]},
        "findings": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
