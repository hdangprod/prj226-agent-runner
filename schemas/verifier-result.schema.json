{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerifierResult",
  "description": "Structured output contract produced by the Verifier agent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role",
    "task",
    "candidate_sha",
    "result",
    "checks",
    "blocking_findings",
    "environment_failures"
  ],
  "properties": {
    "role": {
      "type": "string",
      "enum": ["verifier"]
    },
    "task": {
      "type": "string"
    },
    "candidate_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "result": {
      "type": "string",
      "enum": ["PASS", "FAIL", "ENVIRONMENT_ERROR"]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "ERROR"] },
          "details": { "type": "string" }
        }
      }
    },
    "blocking_findings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "environment_failures": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
