{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Harn002DesignContract",
  "description": "Closed proposal and exact authority boundary for one discovered project task.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "contract_hash", "contract_version", "project_id", "repository_path", "canonical_branch", "run_id",
    "work_item_id", "work_item_title", "work_shape", "intent", "success_criteria", "scope", "non_goals",
    "baseline_head", "baseline_tree", "owned_paths", "protected_dirty_paths", "assumptions", "risks", "dependencies",
    "acceptance_instruments", "discriminating_acceptance_controls", "failure_conditions", "exact_authority_boundary", "readiness"
  ],
  "properties": {
    "contract_id": {"type": "string", "pattern": "^design-[0-9a-f]{64}$"},
    "contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract_version": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "repository_path": {"type": "string", "minLength": 1},
    "canonical_branch": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "work_item_id": {"type": "string", "minLength": 1},
    "work_item_title": {"type": "string", "minLength": 1},
    "work_shape": {"type": "string", "enum": ["SPIKE", "BOUNDED", "ARCHITECTURAL"]},
    "intent": {"type": "string", "minLength": 1},
    "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "non_goals": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "baseline_head": {"$ref": "#/definitions/objectId"},
    "baseline_tree": {"$ref": "#/definitions/objectId"},
    "owned_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/relativePath"}},
    "protected_dirty_paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/relativePath"}},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "acceptance_instruments": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
    },
    "discriminating_acceptance_controls": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "failure_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "exact_authority_boundary": {"type": "string", "minLength": 1},
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_packet", "execution", "runner"],
      "properties": {
        "task_packet": {"type": "string", "enum": ["MISSING / TO_BE_DERIVED_OR_CANONICALIZED_AFTER_GATE_A", "PRESENT / EXECUTION_AUTHORITY_EVIDENCE"]},
        "execution": {"type": "string", "enum": ["NOT AUTHORIZED"]},
        "runner": {"type": "string", "enum": ["NOT INVOKED"]}
      }
    }
  },
  "definitions": {
    "objectId": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.{1,2}(/|$))(?!.*(^|/)\\.git(/|$)).+$"
    }
  }
}
