{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RunManifestV2",
  "description": "Immutable V2 identity and configuration snapshot including contract, packet, policy, and reviewer binding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "run_id",
    "contract_id",
    "contract_hash",
    "task_packet_hash",
    "created_at",
    "product",
    "runtime_root",
    "authorized_paths",
    "acceptance_criteria",
    "test_commands",
    "review_policy",
    "reviewer_binding",
    "roles"
  ],
  "properties": {
    "manifest_version": {"const": "HARN-001.RUN_MANIFEST.v2"},
    "run_id": {"type": "string", "minLength": 1},
    "contract_id": {"type": "string", "pattern": "^design-[0-9a-f]{64}$"},
    "contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_packet_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "minLength": 1},
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "canonical_branch", "baseline_head", "baseline_tree"],
      "properties": {
        "repo": {"type": "string", "minLength": 1},
        "canonical_branch": {"type": "string", "minLength": 1},
        "baseline_head": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "baseline_tree": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
      }
    },
    "runtime_root": {"type": "string", "minLength": 1},
    "authorized_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "test_commands": {"type": "array", "minItems": 1},
    "review_policy": {"type": "object"},
    "reviewer_binding": {"anyOf": [{"type": "null"}, {"type": "object"}]},
    "roles": {"type": "object"}
  }
}
