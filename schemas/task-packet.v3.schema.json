{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskPacketV3",
  "description": "Human-approved V3 execution contract derived from an approved HARN-002.v3 Design Contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_version", "contract_id", "contract_hash", "runtime_root", "review_policy", "run_id", "task_id", "product_repo", "canonical_branch", "baseline_head", "baseline_tree", "authorized_paths", "builder_prompt", "acceptance_criteria", "test_commands", "commit_message"],
  "properties": {
    "packet_version": {"const": "HARN-001.TASK_PACKET.v3"},
    "contract_id": {"type": "string", "pattern": "^design-[0-9a-f]{64}$"},
    "contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_root": {"type": "string", "minLength": 1, "pattern": "^/"},
    "review_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_mode", "change_categories", "human_requested_targeted", "reviewer"],
      "properties": {
        "review_mode": {"type": "string", "enum": ["NONE", "TARGETED"]},
        "change_categories": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "human_requested_targeted": {"type": "boolean"},
        "reviewer": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["tool", "provider", "model", "executable", "resolved_executable", "executable_sha256", "reviewer_profile", "reviewer_profile_hash", "output_schema", "output_schema_sha256", "timeout_seconds", "review_brief"],
              "properties": {
                "tool": {"const": "codex"},
                "provider": {"const": "OpenAI"},
                "model": {"type": "string", "minLength": 1},
                "executable": {"type": "string", "minLength": 1},
                "resolved_executable": {"type": "string", "minLength": 1},
                "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "reviewer_profile": {"type": "object"},
                "reviewer_profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "output_schema": {"type": "string", "minLength": 1},
                "output_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "timeout_seconds": {"type": "integer", "minimum": 1},
                "review_brief": {"type": "string", "minLength": 1}
              }
            }
          ]
        }
      }
    },
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "task_id": {"type": "string", "minLength": 1},
    "product_repo": {"type": "string", "minLength": 1},
    "canonical_branch": {"type": "string", "minLength": 1},
    "baseline_head": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "baseline_tree": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "authorized_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "builder_prompt": {"type": "string", "minLength": 1},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "test_commands": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
    "commit_message": {"type": "string", "minLength": 1},
    "transient_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.{1,2}(/|$))(?!.*(^|/)\\.git(/|$)).+$"
      }
    }
  }
}
