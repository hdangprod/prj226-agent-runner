{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "M2ProjectDefaults",
  "description": "Durable M2 workflow defaults outside the product repository. No generated M1 authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "product_repository",
    "canonical_branch",
    "runtime_root",
    "manifest_source",
    "config_source",
    "scopes"
  ],
  "properties": {
    "schema_version": {
      "const": "PRJ226.PROJECT_DEFAULTS.v1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "product_repository": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/"
    },
    "canonical_branch": {
      "type": "string",
      "minLength": 1
    },
    "runtime_root": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/"
    },
    "manifest_source": {
      "type": "string",
      "minLength": 1
    },
    "config_source": {
      "type": "string",
      "minLength": 1
    },
    "scopes_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "default_scope": {
      "type": [
        "string",
        "null"
      ]
    },
    "default_owned_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/relativePath"
      }
    },
    "default_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "default_transient_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/relativePath"
      }
    },
    "scopes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/scopeDef"
      }
    }
  },
  "definitions": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.{1,2}(/|$))(?!.*(^|/)\\.git(/|$)).+$"
    },
    "scopeDef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owned_paths",
        "checks"
      ],
      "properties": {
        "owned_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/relativePath"
          }
        },
        "change_categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "human_requested_targeted": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "review_brief": {
          "type": "string",
          "minLength": 1
        },
        "transient_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/relativePath"
          }
        }
      }
    }
  }
}
