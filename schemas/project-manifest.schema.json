{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Harn002ProjectManifest",
  "description": "Closed single-project discovery and canonical-document binding for HARN-002.",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "repository_path", "canonical_branch", "canonical_docs", "discovery_rules"],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "repository_path": {"type": "string", "minLength": 1},
    "canonical_branch": {"type": "string", "minLength": 1},
    "canonical_docs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "engineering_plan", "governance", "project"],
      "properties": {
        "current": {"$ref": "#/definitions/relativePath"},
        "engineering_plan": {"$ref": "#/definitions/relativePath"},
        "governance": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/relativePath"}},
        "project": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/relativePath"}}
      }
    },
    "discovery_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_next_work_marker", "plan_task_column", "plan_state_column", "eligible_plan_states", "task_id_pattern", "task_file_glob"],
      "properties": {
        "current_next_work_marker": {"type": "string", "minLength": 1},
        "plan_task_column": {"type": "string", "minLength": 1},
        "plan_state_column": {"type": "string", "minLength": 1},
        "eligible_plan_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "task_id_pattern": {"type": "string", "minLength": 1},
        "task_file_glob": {"type": "string", "minLength": 1}
      }
    }
  },
  "definitions": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.{1,2}(/|$))(?!.*(^|/)\\.git(/|$)).+$"
    }
  }
}
