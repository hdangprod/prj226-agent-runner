{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "M2WorkflowTask",
  "description": "User-facing M2 workflow record. All M1 authority remains in M1 artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "project_id",
    "description",
    "scope",
    "behavior",
    "authorized_paths",
    "checks",
    "review_mode",
    "run_id",
    "status",
    "created_at",
    "updated_at",
    "continuation_path",
    "acceptance_ref",
    "candidate_head",
    "candidate_tree",
    "candidate_ref",
    "review_status",
    "error_class",
    "error",
    "contract_hash",
    "contract_path",
    "builder_binding"
  ],
  "properties": {
    "schema_version": {
      "const": "PRJ226.WORKFLOW_TASK.v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[A-Za-z0-9._-]+$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": [
        "string",
        "null"
      ]
    },
    "behavior": {
      "type": "string",
      "minLength": 1
    },
    "authorized_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/relativePath"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review_mode": {
      "type": "string",
      "enum": [
        "NONE",
        "TARGETED"
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^([A-Za-z0-9][A-Za-z0-9._-]{0,127})?$"
    },
    "status": {
      "type": "string",
      "enum": [
        "PREVIEW",
        "AWAITING_GATE_A",
        "ACCEPTANCE_READY",
        "STOPPED",
        "ACCEPTED"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "continuation_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "acceptance_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "candidate_head": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^([0-9a-fA-F]{40})?$"
    },
    "candidate_tree": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^([0-9a-fA-F]{40})?$"
    },
    "candidate_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "NOT_REQUIRED",
        "PASS",
        "NEEDS_FIX",
        "EXECUTION_FAILURE",
        null
      ]
    },
    "error_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "contract_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^([0-9a-fA-F]{64})?$"
    },
    "contract_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "builder_binding": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "tool",
        "model",
        "executable",
        "timeout_seconds"
      ],
      "additionalProperties": false
    },
    "transient_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/relativePath"
      }
    }
  },
  "definitions": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.{1,2}(/|$))(?!.*(^|/)\\.git(/|$)).+$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "PREVIEW",
              "AWAITING_GATE_A",
              "ACCEPTANCE_READY",
              "ACCEPTED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "contract_hash": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "contract_path": {
            "type": "string",
            "minLength": 1
          },
          "builder_binding": {
            "type": "object"
          }
        },
        "required": [
          "contract_hash",
          "contract_path",
          "builder_binding"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "contract_hash": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        },
        "required": [
          "contract_hash"
        ]
      },
      "then": {
        "properties": {
          "builder_binding": {
            "type": "object"
          }
        },
        "required": [
          "builder_binding"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "contract_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "contract_path"
        ]
      },
      "then": {
        "properties": {
          "builder_binding": {
            "type": "object"
          }
        },
        "required": [
          "builder_binding"
        ]
      }
    }
  ]
}
