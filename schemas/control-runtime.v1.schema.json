{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PRJ226 frozen control runtime v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "roles"],
  "properties": {
    "schema_version": {"const": "PRJ226.CONTROL_RUNTIME.v1"},
    "roles": {
      "type": "object", "additionalProperties": false,
      "required": ["planner", "builder", "reviewer"],
      "properties": {
        "planner": {"$ref": "#/$defs/profile"},
        "builder": {"$ref": "#/$defs/profile"},
        "reviewer": {"$ref": "#/$defs/profile"}
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "backend", "provider", "model", "adapter", "executable", "executable_sha256", "version", "profile_ref", "policy"],
      "properties": {
        "role": {"enum": ["PLANNER", "BUILDER", "REVIEWER"]}, "backend": {"type": "string", "minLength": 1}, "provider": {"type": "string", "pattern": "^[a-z0-9_-]+$"}, "model": {"type": "string", "minLength": 1}, "adapter": {"type": "string", "minLength": 1}, "executable": {"type": "string", "pattern": "^/"}, "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "version": {"type": "string", "minLength": 1}, "profile_ref": {"type": "string", "pattern": "^role-[0-9a-f]{64}$"}, "policy": {"$ref": "#/$defs/policy"}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["sandbox", "approval", "tool_capability", "shell_capability", "repository_write_capability", "network_capability", "retry_count", "fallback_count", "fresh_home", "fresh_codex_home", "session_persistence", "environment_policy", "authentication_policy", "timeout_seconds", "context_policy", "feature_disables"],
      "properties": {
        "sandbox": {"enum": ["read-only", "workspace-write"]}, "approval": {"const": "never"}, "tool_capability": {"enum": ["none", "candidate-write-only"]}, "shell_capability": {"enum": ["prohibited", "workspace-only"]}, "repository_write_capability": {"enum": ["none", "candidate-worktree-owned-paths"]}, "network_capability": {"enum": ["prohibited", "provider-api-only"]}, "retry_count": {"const": 0}, "fallback_count": {"const": 0}, "fresh_home": {"const": true}, "fresh_codex_home": {"const": true}, "session_persistence": {"enum": ["ephemeral-isolated", "session-bound-evidence-persisted"]}, "environment_policy": {"const": "closed-allowlist-only"}, "authentication_policy": {"enum": ["ephemeral-designated-auth-only", "no-auth-required"]}, "timeout_seconds": {"type": "integer", "minimum": 1}, "context_policy": {"type": "string"}, "feature_disables": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
