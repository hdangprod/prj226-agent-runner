{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Harn002HumanGateBAuthorization",
  "description": "Small one-shot Human authorization bound to one exact Gate-B package and live identities.",
  "type": "object",
  "additionalProperties": false,
  "required": ["authorization_id", "gate_b_package_hash", "candidate_head", "candidate_tree", "expected_canonical_head", "expected_canonical_tree"],
  "properties": {
    "authorization_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "gate_b_package_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_head": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "candidate_tree": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "expected_canonical_head": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "expected_canonical_tree": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
  }
}
