{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "M2Continuation",
  "description": "Concise M2 handoff derived only from persisted verified facts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "project_id", "description", "scope", "status", "run_id", "candidate_head", "candidate_tree", "candidate_ref", "checks", "review_mode", "review_status", "blocking_failure", "evidence_references", "must_not_repeat", "next_action", "fresh_authorization_required"],
  "properties": {
    "schema_version": {"const": "PRJ226.CONTINUATION.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "scope": {"type": ["string", "null"]},
    "status": {"type": "string", "minLength": 1},
    "run_id": {"type": ["string", "null"]},
    "candidate_head": {"type": ["string", "null"]},
    "candidate_tree": {"type": ["string", "null"]},
    "candidate_ref": {"type": ["string", "null"]},
    "checks": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
    "review_mode": {"type": "string", "minLength": 1},
    "review_status": {"type": ["string", "null"]},
    "blocking_failure": {"type": ["string", "null"]},
    "evidence_references": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "must_not_repeat": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "next_action": {"type": "string", "minLength": 1},
    "fresh_authorization_required": {"type": "boolean"}
  }
}
